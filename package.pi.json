    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=20"
  },
