# Add these lines for 4K @ 60 Hz on a single HDMI display (Pi 4 / Pi 5).
# Use the micro-HDMI port next to the USB-C power input (HDMI0).
# Requires an HDMI 2.0 cable and a monitor input that supports 4K60.

hdmi_enable_4kp60=1

# Optional: disable overscan if the image is cropped
# disable_overscan=1

# On Bookworm the file may be /boot/firmware/config.txt instead of /boot/config.txt
