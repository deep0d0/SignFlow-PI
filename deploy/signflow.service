[Unit]
Description=SignFlow signage server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signflow
Group=signflow
WorkingDirectory=/opt/signflow
Environment=SIGNFLOW_APP_ROOT=/opt/signflow
Environment=SIGNFLOW_DATA_DIR=/var/lib/signflow
Environment=SIGNFLOW_BIND_HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/signflow/dist/pi/server.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
