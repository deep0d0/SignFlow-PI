{
  "name": "signflow",
  "version": "1.0.0",
  "productName": "SignFlow",
  "description": "Create and display animated signage",
  "private": true,
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:pi": "node scripts/build-pi.mjs",
    "build:pi-deploy": "npm run build:renderer && npm run build:pi",
    "build": "npm run build:electron && npm run build:renderer",
    "build:all": "npm run build && npm run build:pi",
    "dev": "node scripts/dev.mjs",
    "start:pi": "node dist/pi/server.cjs",
    "dist": "npm run build && electron-builder && node scripts/copy-releases.mjs",
    "dist:mac": "npm run build && electron-builder --mac && node scripts/copy-releases.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "app.signflow",
    "productName": "SignFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "app-icon.icns",
      "minimumSystemVersion": "11.0",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    }
  }
}
